# Firebase client configuration (Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK credentials. Keep private; never use NEXT_PUBLIC_ prefix.
# Use a service account JSON's project_id, client_email and private_key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Email is optional. If configured, transactional quote notifications use Resend.
RESEND_API_KEY=
EMAIL_FROM=

# The one account allowed to bootstrap as the initial super admin.
# Register with this exact email after Firebase is configured.
SUPER_ADMIN_EMAIL=

# Optional absolute public origin used in email links and generated labels.
NEXT_PUBLIC_APP_URL=http://localhost:3000
